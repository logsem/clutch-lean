module

public import Metrology.ProbLang.Measure
public import Metrology.ProbLang.Syntax.HeapArray

@[expose] public section

/-! # Measurable space on heaps

The σ-algebra on `LocHeap V` generated by the lookups `m[ℓ]?`. -/

noncomputable section
open MeasureTheory Set
open Measurable (of_comap_le option_of_cov)
open Std.ExtTreeMap (mem_iff_isSome_getElem? maxKey?_eq_none_iff not_mem_empty ext_getElem?
  maxKey?_eq_some_iff_getElem? getElem?_insert)

namespace ProbLang
namespace LocHeap

variable {V : Type _}

/-! ## Preimages of `maxKey?`

`fresh` is `maxKey? + 1`, so we first describe the preimages of `maxKey?` through countably many
lookups. -/

/-- `maxKey? = none` iff no location is allocated. -/
theorem maxKey?_preimage_none :
    (fun m : LocHeap V => m.maxKey?) ⁻¹' ({none} : Set (Option Loc)) = {m | ∀ k : Loc, k ∉ m} := by
  ext m
  simp only [mem_preimage, mem_singleton_iff, mem_ofPred_eq, maxKey?_eq_none_iff]
  exact ⟨fun h k => h ▸ not_mem_empty,
    fun h => ext_getElem? fun k => by
      rcases hk : m[k]? with _ | v
      · simp
      · exact absurd (mem_iff_isSome_getElem?.mpr (by rw [hk]; rfl)) (h k)⟩

/-- The preimage of `some '' S` under `maxKey?` is a countable union of measurable cells. -/
theorem maxKey?_preimage_some (S : Set Loc) :
    (fun m : LocHeap V => m.maxKey?) ⁻¹' (some '' S) =
      ⋃ n ∈ S, {m : LocHeap V | n ∈ m} ∩ ⋂ k ∈ {k : Loc | n < k}, {m | k ∉ m} := by
  ext m
  simp only [mem_preimage, mem_image, mem_iUnion, exists_prop, mem_inter_iff, mem_ofPred_eq,
    mem_iInter]
  refine exists_congr fun n => and_congr_right fun _ => ?_
  rw [eq_comm, maxKey?_eq_some_iff_getElem?, ← mem_iff_isSome_getElem?]
  refine and_congr_right fun _ => forall_congr' fun k => forall_congr' fun _ => ?_
  rw [mem_iff_isSome_getElem?]
  cases m[k]? <;> simp

variable [MeasurableSpace V] (ℓ : Loc)

/-! ## The σ-algebra and lookups -/

/-- Heaps carry the σ-algebra generated by the lookups `m[ℓ]?`. -/
instance instMeasurableSpace : MeasurableSpace (LocHeap V) :=
  MeasurableSpace.comap (fun (m : LocHeap V) (ℓ : Loc) => m[ℓ]?) inferInstance

/-- Each lookup `m ↦ m[ℓ]?` is measurable. -/
@[fun_prop]
theorem measurable_getElem? : Measurable (fun (m : LocHeap V) => m[ℓ]?) :=
  (measurable_pi_apply ℓ).comp (of_comap_le le_rfl)

/-- A map into heaps is measurable iff every lookup of its output is. -/
theorem measurable_iff {X : Type _} [MeasurableSpace X] {f : X → LocHeap V} :
    Measurable f ↔ ∀ ℓ : Loc, Measurable (fun x => (f x)[ℓ]?) :=
  ⟨fun hf ℓ => (measurable_getElem? ℓ).comp hf,
   fun h => measurable_comap_iff.mpr (measurable_pi_iff.mpr h)⟩

/-- Having `ℓ` allocated is a measurable property of a heap. -/
theorem measurableSet_mem : MeasurableSet {m : LocHeap V | ℓ ∈ m} := by
  have hset : {m : LocHeap V | ℓ ∈ m} = (fun m => m[ℓ]?) ⁻¹' ({none} : Set (Option V))ᶜ := by
    ext m
    simp only [mem_ofPred_eq, mem_iff_isSome_getElem?, mem_preimage, mem_compl_iff,
      mem_singleton_iff]
    cases (m[ℓ]? : Option V) <;> simp
  rw [hset]
  exact (measurable_getElem? ℓ) MeasurableSet.singleton_none.compl

/-- Not having `ℓ` allocated is a measurable property of a heap. -/
theorem measurableSet_notMem : MeasurableSet {m : LocHeap V | ℓ ∉ m} :=
  (measurableSet_mem ℓ).compl

/-! ## Insertion -/

/-- Inserting at a fixed location is measurable in the heap and the value. -/
@[fun_prop]
theorem _root_.ProbLang.Measurable.locHeap_insert :
    Measurable (fun (p : LocHeap V × V) => p.1.insert ℓ p.2) := by
  refine measurable_iff.mpr fun k => ?_
  have hrw : (fun (p : LocHeap V × V) => (p.1.insert ℓ p.2)[k]?) =
      fun p => if compare ℓ k = .eq then some p.2 else p.1[k]? :=
    funext fun _ => getElem?_insert
  rw [hrw]
  split_ifs
  · exact measurable_some.comp measurable_snd
  · exact (measurable_getElem? k).comp measurable_fst

/-- Insertion is measurable jointly in `(m, ℓ, v)`. -/
@[fun_prop]
theorem _root_.ProbLang.Measurable.locHeap_insert_param :
    Measurable (fun (q : LocHeap V × Loc × V) => q.1.insert q.2.1 q.2.2) := by
  have hflat : Measurable (fun q : Loc × LocHeap V × V => q.2.1.insert q.1 q.2.2) :=
    measurable_from_prod_countable_right Measurable.locHeap_insert
  exact hflat.comp (f := fun q : LocHeap V × Loc × V => (q.2.1, q.1, q.2.2)) (by fun_prop)

/-! ## Fresh locations -/

/-- The largest allocated location is a measurable function of the heap. -/
@[fun_prop]
theorem measurable_maxKey? : Measurable (fun (m : LocHeap V) => m.maxKey?) := by
  refine option_of_cov (cov := {m : LocHeap V | ∃ k : Loc, k ∈ m}) ?_ ?_ ?_
  · rw [show {m : LocHeap V | ∃ k : Loc, k ∈ m} = ⋃ k : Loc, {m | k ∈ m} from ext fun m => by simp]
    exact .iUnion measurableSet_mem
  · rw [maxKey?_preimage_none]
    exact ext fun m => by simp
  · intro S _
    rw [maxKey?_preimage_some]
    exact .biUnion (to_countable S) fun n _ =>
      (measurableSet_mem n).inter <| .biInter (to_countable _) fun k _ => measurableSet_notMem k

/-- The fresh location of a heap is a measurable function of the heap. -/
@[fun_prop]
theorem measurable_fresh : Measurable (fun (m : LocHeap V) => m.fresh) := by
  have hrw : (fun (m : LocHeap V) => m.fresh) = fun m => m.maxKey?.getD 0 + 1 := by
    funext m
    show (match m.maxKey? with | none => (1 : Loc) | some v => v + 1) = m.maxKey?.getD 0 + 1
    rcases m.maxKey? with _ | _ <;> rfl
  rw [hrw]
  exact (Option.measurable_getD 0 |>.comp measurable_maxKey?).add_const 1

/-- Repeated fresh insertion is measurable in the heap and the value. -/
@[fun_prop]
theorem measurable_allocN (n : Nat) :
    Measurable (fun p : LocHeap V × V => allocN p.1 p.2 n) := by
  induction n with
  | zero => exact measurable_fst
  | succ n ih =>
    exact ih.comp (((Measurable.locHeap_insert_param (V := V)).comp
      (measurable_fst.prodMk ((measurable_fresh.comp measurable_fst).prodMk
        measurable_snd))).prodMk measurable_snd)

/-- Block allocation is measurable jointly in its count, heap and initializer. -/
@[fun_prop]
theorem measurable_allocN_param :
    Measurable (fun p : Nat × LocHeap V × V => allocN p.2.1 p.2.2 p.1) :=
  measurable_from_prod_countable_right measurable_allocN

end LocHeap
end ProbLang
